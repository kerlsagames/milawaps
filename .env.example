# Six-digit staff PIN. Leave unset in local dev to use 737373.
# If you set this, it must be exactly six digits or the desk refuses to unlock.
STAFF_PIN=737373

# Jimmy’s cricket share host. A short code in Settings is fetched from
# CRICKET_SHARE_ORIGIN/api/share/<code>. A full https share link works without this.
# CRICKET_SHARE_ORIGIN=https://example.vercel.app

# Required on Vercel (Production / Preview). Without a durable store, ticks
# reset between serverless instances.
#
# Preferred (already used on milawaps): connect a private Vercel Blob store.
# The dashboard fills BLOB_READ_WRITE_TOKEN (and BLOB_STORE_ID with OIDC).
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
#
# Optional alternative: Upstash Redis via Storage → Create Database.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Accepted as a fallback if the integration only exposes Upstash names.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
