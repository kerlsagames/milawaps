# Four-digit staff PIN. Required in production. Local `npm run dev` uses 2468 if this is unset.
STAFF_PIN=2468

# Vercel KV, or the same values from a Vercel Redis / Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Accepted as a fallback if the integration only exposes Upstash names.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
