# Six-digit staff PIN. Leave unset in local dev to use 737373.
# If you set this, it must be exactly six digits or the desk refuses to unlock.
STAFF_PIN=737373

# Vercel KV, or the same values from a Vercel Redis / Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Accepted as a fallback if the integration only exposes Upstash names.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
